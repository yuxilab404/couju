{
  "name": "couju",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "sdk",
    "protocol",
    "server",
    "platform",
    "games/_kit/*",
    "games/*",
    "web",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build web",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-deps": "node scripts/check-deps.mjs",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts --trace off",
    "ci": "npm run typecheck && npm run check-deps && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "typescript": "5.7",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}
